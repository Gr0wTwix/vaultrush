# Optional: connect the site to your own Supabase project. Without these the site runs fully in the browser.
# Both values are safe to expose in the browser (the anon key only does what row-level security allows).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
