# Copy this file to ".env" (same folder) and fill it in. ".env" is ignored by git: it holds secrets, never commit it.

# A long random string. KEEP IT: without it n8n cannot read its saved credentials again after a restart.
# Make one in PowerShell:
#   $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
N8N_ENCRYPTION_KEY=

# Your time zone (the daily report runs at 09:00 in it), e.g. Europe/Sofia, Europe/London, America/New_York
GENERIC_TIMEZONE=UTC

# Only for the tunnel (docker compose --profile tunnel up -d): from your free ngrok account.
#   NGROK_AUTHTOKEN: ngrok dashboard > Your Authtoken
#   NGROK_DOMAIN:    ngrok dashboard > Domains: your free "dev domain", e.g. something-something.ngrok-free.dev (or .app), copied exactly, no https://
#   (You do NOT need to run "ngrok config add-authtoken" on your PC: Docker runs ngrok and reads the token from here.)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# What the n8n editor shows as the "Production URL" of a webhook. With the tunnel: https://<your NGROK_DOMAIN>/
N8N_WEBHOOK_URL=http://localhost:5678/
