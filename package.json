{
  "name": "vaultrush",
  "version": "0.2.0",
  "private": true,
  "description": "Vaultrush: a play-money skin-game demo (no real money, no cash value).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.strict.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
